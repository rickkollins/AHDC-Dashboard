# Copy this file to .env and fill in real values. Never commit .env itself.

# Port the Node process listens on (nginx will proxy to this).
PORT=3000

# Generate with: node scripts/hash-password.js "your chosen password"
ADMIN_PASSWORD_HASH=

# A long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Per-file upload size limit, in MB.
MAX_UPLOAD_MB=25

# Max number of files accepted in a single portal upload.
MAX_FILES_PER_UPLOAD=10

# Leave unset (or "true") once nginx is serving HTTPS in front of this app —
# the session cookie will then only be sent over HTTPS, which is what you want
# in production. Set to "false" only while testing locally over plain http://.
COOKIE_SECURE=true
